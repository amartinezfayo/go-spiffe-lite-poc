From 770fd33478337a7939777ed10cc96d205f6fc0bc Mon Sep 17 00:00:00 2001
From: PoC Maintainer <poc@example.org>
Date: Wed, 21 Oct 2026 16:07:38 -0500
Subject: [PATCH] Pin lite require to v0.1.0 and drop the replace directive

---
 .github/workflows/pr_build.yaml |  9 +++++++--
 Makefile                        | 13 +++++++++++++
 go.mod                          |  4 +---
 go.sum                          |  2 ++
 go.work                         | 24 +++++++++++++-----------
 5 files changed, 36 insertions(+), 16 deletions(-)

diff --git a/.github/workflows/pr_build.yaml b/.github/workflows/pr_build.yaml
index 315692b..d3ef750 100644
--- a/.github/workflows/pr_build.yaml
+++ b/.github/workflows/pr_build.yaml
@@ -51,8 +51,13 @@ jobs:
       # anything beyond go-jose.
       - name: Check lite module dependencies
         run: make lite-deps-check
-      # go.work makes local builds resolve the lite module from disk. Confirm
-      # the v2 module also builds the way a consumer resolves it.
+      # A merged replace directive would make the v2 module unresolvable for
+      # consumers pinning it at a branch or commit.
+      - name: Check for replace directives
+        run: make replace-check
+      # go.work makes in-repo builds resolve the lite module from disk. With no
+      # replace in go.mod, building outside the workspace resolves lite from its
+      # released tag, the way a consumer does.
       - name: Build outside the workspace
         run: GOWORK=off go build ./...
 
diff --git a/Makefile b/Makefile
index 364eaf9..580fada 100644
--- a/Makefile
+++ b/Makefile
@@ -15,6 +15,7 @@ help:
 	@echo "  sync             - copy shared test support code from lite/ into the v2 module"
 	@echo "  sync-check       - ensure the copied test support code is up to date"
 	@echo "  lite-deps-check  - ensure the lite module stays free of heavyweight dependencies"
+	@echo "  replace-check    - ensure go.mod files carry no replace directives"
 
 # This repository contains two Go modules: the full github.com/spiffe/go-spiffe/v2
 # module rooted here, and the lightweight github.com/spiffe/go-spiffe/lite module
@@ -263,6 +264,18 @@ lite-deps-check: | go-check
 		fi
 	@echo "Lite module dependencies are OK."
 
+# Consumers ignore replace directives in a dependency's go.mod, so a merged
+# replace would make the module unresolvable for anyone pinning it at a
+# branch or commit. The lite require must always point at a released tag.
+.PHONY: replace-check
+replace-check:
+	@echo "Checking that go.mod files carry no replace directives..."
+	@if grep -nE '^replace' go.mod lite/go.mod; then \
+		echo "replace directives must not be merged; pin a released tag instead."; \
+		exit 1; \
+	fi
+	@echo "No replace directives found."
+
 .PHONY: git-clean-check
 git-clean-check:
 ifneq ($(git_dirty),)
